@startuml 数据访问层与实体层类图
skinparam defaultFontName "Microsoft YaHei"
skinparam classAttributeIconSize 0
skinparam defaultFontSize 12

package "Mapper 数据访问层" {
  class UserMapper
  class CompanyMapper
  class ResumeMapper
  class JobMapper
  class ApplyMapper
  class AiScoreMapper
  UserMapper -[hidden]d- CompanyMapper
  CompanyMapper -[hidden]d- ResumeMapper
  ResumeMapper -[hidden]d- JobMapper
  JobMapper -[hidden]d- ApplyMapper
  ApplyMapper -[hidden]d- AiScoreMapper
  note bottom of UserMapper
    继承 BaseMapper<T>
    提供 selectById/selectList/
    selectPage/insert/updateById/
    deleteById 等通用方法
  end note
}

package "entity 实体层" {
  class User {
    -id : Long
    -username : String
    -password : String
    -role : String
    -name : String
    -phone : String
    -status : Integer
    -createTime : LocalDateTime
    +getId() : Long
    +setId(id : Long) : void
    +getUsername() : String
    +setUsername(username : String) : void
    +getRole() : String
    +setRole(role : String) : void
    +getStatus() : Integer
    +setStatus(status : Integer) : void
  }
  class Company {
    -id : Long
    -userId : Long
    -name : String
    -industry : String
    -scale : String
    -contact : String
    -approved : Integer
    -createTime : LocalDateTime
    +getId() : Long
    +setId(id : Long) : void
    +getUserId() : Long
    +setUserId(userId : Long) : void
    +getName() : String
    +setName(name : String) : void
    +getApproved() : Integer
    +setApproved(approved : Integer) : void
  }
  class Resume {
    -id : Long
    -userId : Long
    -name : String
    -school : String
    -edu : String
    -age : Integer
    -skills : String
    -experience : String
    -content : String
    -createTime : LocalDateTime
    +getId() : Long
    +setId(id : Long) : void
    +getUserId() : Long
    +setUserId(userId : Long) : void
    +getEdu() : String
    +setEdu(edu : String) : void
    +getSkills() : String
    +setSkills(skills : String) : void
  }
  class Job {
    -id : Long
    -companyId : Long
    -title : String
    -city : String
    -salary : String
    -type : String
    -skills : String
    -eduReq : String
    -description : String
    -status : Integer
    -createTime : LocalDateTime
    +getId() : Long
    +setId(id : Long) : void
    +getCompanyId() : Long
    +setCompanyId(companyId : Long) : void
    +getSkills() : String
    +setSkills(skills : String) : void
    +getStatus() : Integer
    +setStatus(status : Integer) : void
  }
  class Apply {
    -id : Long
    -studentId : Long
    -jobId : Long
    -status : String
    -applyTime : LocalDateTime
    +getId() : Long
    +setId(id : Long) : void
    +getStatus() : String
    +setStatus(status : String) : void
  }
  class AiScore {
    -id : Long
    -applyId : Long
    -score : Integer
    -reason : String
    -createTime : LocalDateTime
    +getId() : Long
    +setId(id : Long) : void
    +getScore() : Integer
    +setScore(score : Integer) : void
    +getReason() : String
    +setReason(reason : String) : void
  }
  User -[hidden]r- Company
  Company -[hidden]d- Resume
  Resume -[hidden]r- Job
  Job -[hidden]d- Apply
  Apply -[hidden]r- AiScore
}

package "AI 服务" {
  class "ChatClient（Spring AI）" as ChatClient {
    +prompt(text) : Request
    +call() : Response
  }
  class "通义千问 API" as Qwen
  ChatClient -[hidden]d- Qwen
}

UserMapper -- User
CompanyMapper -- Company
ResumeMapper -- Resume
JobMapper -- Job
ApplyMapper -- Apply
AiScoreMapper -- AiScore

AiMatchService -- ChatClient : 调用
ChatClient -- Qwen

note bottom of Resume
  content=简历全文
  edu/skills/experience
  =AI解析结构化字段
end note
@enduml