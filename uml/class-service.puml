@startuml 控制层与业务层类图
skinparam defaultFontName "Microsoft YaHei"
skinparam classAttributeIconSize 0
skinparam defaultFontSize 13

package "Controller 控制层" {
  class AuthController {
    -userService : UserService
    +login(req : Map<String,String>) : Result
    +register(req : Map<String,String>) : Result
    +logout(token : String) : Result
  }
  class StudentController {
    -jobService : JobService
    -applyService : ApplyService
    -resumeService : ResumeService
    +searchJobs(keyword, city, type, page, size) : Result
    +jobDetail(id : Long) : Result
    +apply(jobId : Long) : Result
    +myApplies(page, size) : Result
    +myResume() : Result
    +saveResume(resume : Resume) : Result
  }
  class CompanyController {
    -jobService : JobService
    -applyService : ApplyService
    -aiMatchService : AiMatchService
    +info() : Result
    +myJobs() : Result
    +publish(job : Job) : Result
    +update(job : Job) : Result
    +offline(jobId : Long) : Result
    +applies(jobId, page, size) : Result
    +updateApplyStatus(applyId, status) : Result
    +aiFilter(jobId : Long) : Result
  }
  class AdminController {
    -adminService : AdminService
    -jobService : JobService
    +companies(approved : Integer) : Result
    +auditCompany(companyId, pass) : Result
    +jobs(status : Integer) : Result
    +auditJob(jobId, pass) : Result
    +users() : Result
    +updateUserStatus(userId, status) : Result
    +stats() : Result
  }
  class AiController {
    -chatClient : ChatClient
    -aiResumeService : AiResumeService
    -aiMatchService : AiMatchService
    -redis : StringRedisTemplate
    +chat(question) : Result
    +chatStream(question) : Flux<String>
    +parseResume(resumeId) : Result
    +recommend() : Result
    +applyAdvice(applyId) : Result
  }
  AuthController -[hidden]d- StudentController
  StudentController -[hidden]d- CompanyController
  CompanyController -[hidden]d- AdminController
  AdminController -[hidden]d- AiController
}

package "Service 业务层" {
  class UserService {
    +login(username, password) : Map
    +register(req : Map) : void
    +logout(token : String) : void
  }
  class ResumeService {
    +getByUserId(userId) : Resume
    +save(userId, form) : void
    +getById(id) : Resume
    +update(resume : Resume) : void
  }
  class JobService {
    +publish(companyUserId, job) : void
    +update(companyUserId, form) : void
    +offline(companyUserId, jobId) : void
    +search(keyword, city, type, page, size) : Map
    +detail(jobId) : Map
    +listByCompany(companyUserId) : List
    +listByStatus(status) : List
    +audit(jobId, pass) : void
    +getCompanyByUserId(companyUserId) : Company
  }
  class ApplyService {
    +apply(studentId, jobId) : void
    +listByStudent(studentId, page, size) : Map
    +listByJob(companyUserId, jobId, page, size) : Map
    +updateStatus(companyUserId, applyId, status) : void
  }
  class AiResumeService {
    +parse(resumeId) : Resume
  }
  class AiMatchService {
    +filter(companyUserId, jobId) : List
    +recommend(studentId) : List
    +applyAdvice(studentId, applyId) : String
  }
  UserService -[hidden]d- ResumeService
  ResumeService -[hidden]d- JobService
  JobService -[hidden]d- ApplyService
  ApplyService -[hidden]d- AiResumeService
  AiResumeService -[hidden]d- AiMatchService
}

AuthController -- UserService
StudentController -- ResumeService
StudentController -- JobService
StudentController -- ApplyService
CompanyController -- JobService
CompanyController -- ApplyService
CompanyController -- AiMatchService
AdminController -- UserService
AdminController -- JobService
AiController -- AiResumeService
AiController -- AiMatchService
@enduml