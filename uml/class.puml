@startuml 类图
skinparam defaultFontName "Microsoft YaHei"
skinparam classAttributeIconSize 0
skinparam linetype polyline

package "Controller 控制层" {
  class AuthController {
    +login(username : String, password : String) : Result
    +register(user : User) : Result
  }
  class StudentController {
    +uploadResume(resume : Resume) : Result
    +searchJobs(keyword : String, city : String, type : String) : Result
    +applyJob(jobId : Long) : Result
    +listMyApplies(studentId : Long) : Result
  }
  class CompanyController {
    +publishJob(job : Job) : Result
    +offlineJob(jobId : Long) : Result
    +listApplies(jobId : Long) : Result
    +invite(applyId : Long) : Result
  }
  class AdminController {
    +auditCompany(companyId : Long, pass : Boolean) : Result
    +auditJob(jobId : Long, pass : Boolean) : Result
    +listUsers() : Result
    +statistics() : Result
  }
  class AiController {
    +chat(question : String) : Map<String, String>
    +parseResume(resumeId : Long) : Result
    +filterCandidates(jobId : Long) : Result
  }
}

package "Service 业务层" {
  class UserService {
    +login(username : String, password : String) : User
    +register(user : User) : void
    +listAll() : List<User>
  }
  class ResumeService {
    +save(resume : Resume) : void
    +getByUserId(userId : Long) : Resume
  }
  class JobService {
    +publish(job : Job) : void
    +search(keyword : String, city : String, type : String) : List<Job>
    +audit(jobId : Long, pass : Boolean) : void
  }
  class ApplyService {
    +apply(studentId : Long, jobId : Long) : void
    +listByJob(jobId : Long) : List<Apply>
    +updateStatus(applyId : Long, status : String) : void
  }
  class AiResumeService {
    -promptTemplate : String
    +parse(content : String) : Resume
  }
  class AiMatchService {
    +filter(jobId : Long) : List<AiScore>
    +score(resume : Resume, job : Job) : AiScore
  }
}

package "Mapper 数据访问层" {
  class UserMapper {
    +selectOne(wrapper) : User
    +selectList(wrapper) : List<User>
  }
  class CompanyMapper
  class ResumeMapper
  class JobMapper
  class ApplyMapper
  class AiScoreMapper
}

package "entity 实体层" {
  class User {
    -id : Long
    -username : String
    -password : String
    -role : String
    -name : String
    -phone : String
    -status : Integer
    -createTime : LocalDateTime
  }
  class Company {
    -id : Long
    -userId : Long
    -name : String
    -industry : String
    -scale : String
    -contact : String
    -approved : Integer
  }
  class Resume {
    -id : Long
    -userId : Long
    -name : String
    -school : String
    -edu : String
    -age : Integer
    -skills : String
    -experience : String
    -content : String
  }
  class Job {
    -id : Long
    -companyId : Long
    -title : String
    -city : String
    -salary : String
    -type : String
    -skills : String
    -eduReq : String
    -status : Integer
  }
  class Apply {
    -id : Long
    -studentId : Long
    -jobId : Long
    -status : String
    -applyTime : LocalDateTime
  }
  class AiScore {
    -id : Long
    -applyId : Long
    -score : Integer
    -reason : String
  }
}

package "AI 服务" {
  class "ChatClient（Spring AI）" as ChatClient {
    +prompt(text : String) : ChatClientRequest
    +call() : ChatResponse
  }
  class "通义千问 API" as Qwen
}

AuthController --> UserService
StudentController --> ResumeService
StudentController --> JobService
StudentController --> ApplyService
CompanyController --> JobService
CompanyController --> ApplyService
CompanyController --> AiMatchService
AdminController --> UserService
AdminController --> JobService
AiController --> AiResumeService
AiController --> AiMatchService

UserService --> UserMapper
ResumeService --> ResumeMapper
JobService --> JobMapper
ApplyService --> ApplyMapper
AiResumeService --> ResumeMapper
AiMatchService --> ApplyMapper
AiMatchService --> AiScoreMapper
AiMatchService --> ChatClient

UserMapper --> User
CompanyMapper --> Company
ResumeMapper --> Resume
JobMapper --> Job
ApplyMapper --> Apply
AiScoreMapper --> AiScore

ChatClient --> Qwen
@enduml
