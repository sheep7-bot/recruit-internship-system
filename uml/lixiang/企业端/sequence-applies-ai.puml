@startuml 企业查看投递并AI筛选时序图
skinparam defaultFontName "Microsoft YaHei"
hide footbox
<style>
participant {
  FontColor white
  BorderColor white
  BackgroundColor white
}
sequenceDiagram {
  FontColor black
}
</style>
skinparam sequenceMessageAlign center
participant "HR" as hr
participant "企业端投递筛选页" as web
participant "CompanyController" as ctl
participant "ApplyServiceImpl" as asvc
participant "AiMatchServiceImpl" as aivc
hr -> web : 进入某岗位的投递列表
web -> ctl : GET /api/company/applies?jobId&page&size
ctl -> asvc : listByJob(companyUserId, jobId, page, size)
note over asvc
  checkJobOwned 归属校验
end note
alt 岗位不属于当前企业
  asvc --> ctl : 抛异常"无权操作"
else 校验通过
  note over asvc
    分页查投递 applyList
  end note
  note over asvc
    补学生姓名/简历/AI评分
  end note
  asvc --> ctl : Map{records, total}
  ctl --> web : Result(data=Map)
  web --> hr : 展示候选人列表
end

hr -> web : 点击"AI筛选候选人"
web -> ctl : POST /api/company/ai-filter/{jobId}
ctl -> aivc : filter(companyUserId, jobId)
note over aivc
  归属校验
end note
loop 每个候选人
  note over aivc
    规则通道 checkRule
  end note
  alt 通过规则
    note over aivc
      组装提示词调大模型
    end note
    note over aivc
      score+reason 组装 AiScore
    end note
  else 未通过
    note over aivc
      组装 AiScore(0分+原因)
    end note
  end
  note over aivc
    覆盖落库 t_ai_score
  end note
end
aivc --> ctl : List<Map>(按分排序)
ctl --> web : Result(data=评分列表)
web --> hr : 高匹配候选人置顶展示

@enduml