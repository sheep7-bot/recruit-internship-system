@startuml 岗位搜索缓存核心算法流程图
skinparam defaultFontName "Microsoft YaHei"
skinparam roundCorner 0

start
:开始;
:输入keyword/city/type/page/size;
:分页参数兜底;
:拼接缓存key;
:GET Redis缓存;
if (缓存命中?) then
  :反序列化JSON返回Map;
else
  :组装LambdaQueryWrapper;
  :eq(status=1)动态条件;
  :关键词like title or skills;
  :orderByDesc(createTime);
  :selectPage分页查库;
  if (查询成功?) then
    :fillCompanyName补企业名;
    :组装Map{records,total};
    :SET Redis缓存TTL5分钟;
    :返回结果;
  else
    :异常处理;
  endif
endif
:结束;
stop
@enduml
