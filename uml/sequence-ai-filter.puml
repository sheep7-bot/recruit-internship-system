@startuml AI筛选时序图
skinparam defaultFontName "Microsoft YaHei"
hide footbox
<style>
participant {
  FontColor white
  BorderColor white
  BackgroundColor white
}
sequenceDiagram {
  FontColor black
}
</style>
skinparam sequenceMessageAlign center
participant "HR" as hr
participant "企业端页面" as web
participant "AiController" as ai
participant "AiMatchService" as svc
participant "ChatClient(Spring AI)" as llm
hr -> web : 点击"AI筛选候选人"
web -> ai : POST /api/ai/filter {jobId:Long}
ai -> svc : filter(jobId)
note over svc
  校验岗位归属
end note
note over svc
  查询该岗位投递记录+简历
end note
loop 每个候选人
  note over svc
    规则筛选(学历/技能)
  end note
  alt 通过规则
    svc -> llm : 简历+岗位要求 → 评分
    llm --> svc : score:Integer + reason:String
    note over svc
      组装 AiScore 中间数据并覆盖落库
    end note
  else 未通过规则
    note over svc
      组装 AiScore(0分+原因)落库
    end note
  end
end
svc --> ai : List<Map>(applyId,status,rulePassed,aiScore,aiReason)
ai --> web : Result(data=评分列表)
web --> hr : 展示高匹配候选人(按分排序)

@enduml