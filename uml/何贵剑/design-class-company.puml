@startuml 何贵剑-企业端设计类图
skinparam defaultFontName "Microsoft YaHei"
skinparam classAttributeIconSize 0
skinparam defaultFontSize 14

package "Controller 控制层" {
  class CompanyController {
    +info() : Result
    +myJobs() : Result
    +publish(job) : Result
    +update(job) : Result
    +offline(jobId) : Result
    +applies(jobId, page, size) : Result
    +updateApplyStatus(applyId, status) : Result
    +aiFilter(jobId) : Result
  }
}

package "Service 业务层" {
  class JobServiceImpl {
    +publish(companyUserId, job) : void
    +update(companyUserId, form) : void
    +offline(companyUserId, jobId) : void
    +listByCompany(companyUserId) : List
    +getOwned(companyUserId, jobId) : Job
  }
  class ApplyServiceImpl {
    +listByJob(companyUserId, jobId, page, size) : Map
    +updateStatus(companyUserId, applyId, status) : void
    +checkJobOwned(companyUserId, jobId) : void
  }
  class AiMatchServiceImpl {
    +filter(companyUserId, jobId) : List<Map>
  }
}

package "Mapper 数据访问层" {
  class JobMapper
  class CompanyMapper
  class ApplyMapper
  class ResumeMapper
  class UserMapper
  class AiScoreMapper
}

package "entity 实体层" {
  class Company {
    -id : Long
    -userId : Long
    -name : String
    -approved : Integer
  }
  class Job {
    -id : Long
    -companyId : Long
    -title : String
    -status : Integer
  }
  class Apply {
    -id : Long
    -studentId : Long
    -jobId : Long
    -status : String
  }
  class Resume {
    -id : Long
    -userId : Long
    -name : String
  }
  class User {
    -id : Long
    -name : String
  }
}

class "StringRedisTemplate（清缓存）" as redis

CompanyController --> JobServiceImpl
CompanyController --> ApplyServiceImpl
CompanyController --> AiMatchServiceImpl

JobServiceImpl --> JobMapper
JobServiceImpl --> CompanyMapper
JobServiceImpl --> redis : evictJobCache
ApplyServiceImpl --> ApplyMapper
ApplyServiceImpl --> JobMapper
ApplyServiceImpl --> CompanyMapper
ApplyServiceImpl --> ResumeMapper
ApplyServiceImpl --> UserMapper
ApplyServiceImpl --> AiScoreMapper
AiMatchServiceImpl --> JobMapper
AiMatchServiceImpl --> CompanyMapper
AiMatchServiceImpl --> ApplyMapper
@enduml