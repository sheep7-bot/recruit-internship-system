@startuml 企业查看投递并AI筛选时序图
skinparam defaultFontName "Microsoft YaHei"
skinparam sequenceMessageAlign center

actor "HR" as hr
participant "企业端投递筛选页" as web
participant "CompanyController" as ctl
participant "ApplyServiceImpl" as asvc
participant "AiMatchServiceImpl" as aivc
database "MySQL" as db
participant "通义千问" as llm

hr -> web : 进入某岗位的投递列表
web -> ctl : GET /api/company/applies?jobId=&page&size
ctl -> asvc : listByJob(companyUserId, jobId, page, size)
asvc -> asvc : checkJobOwned 归属校验
alt 岗位不属于当前企业
  asvc --> ctl : 抛异常"无权操作"
else 校验通过
  asvc -> db : selectPage 查该岗位投递
  asvc -> db : 补学生姓名/简历/AI评分
  asvc --> ctl : {records, total}
  ctl --> web : Result
  web --> hr : 展示候选人列表
end

hr -> web : 点击"AI筛选候选人"
web -> ctl : POST /api/company/ai-filter/{jobId}
ctl -> aivc : filter(companyUserId, jobId)
aivc -> aivc : 归属校验
loop 每个候选人
  aivc -> aivc : 规则通道 checkRule
  opt 通过规则
    aivc -> llm : 评分提示词
    llm --> aivc : score+reason
  end
  aivc -> db : 覆盖落库 t_ai_score
end
aivc --> ctl : 按分排序的候选人列表
ctl --> web : Result
web --> hr : 高匹配候选人置顶展示
@enduml