@startuml 岗位搜索缓存核心算法流程图
skinparam defaultFontName "Microsoft YaHei"
skinparam activityDiamondFontSize 13
skinparam activityFontSize 13
skinparam defaultTextAlignment center

start
:输入 keyword/city/type/page/size;
:分页兜底 page=max(page,1) size=合法化;
:拼接缓存key cache:jobs:{keyword}|{city}|{type}|p{page}s{size};
:GET Redis 缓存;
if (缓存命中?) then (是)
  :反序列化 JSON 返回;
  stop
else (否)
endif
:组装 LambdaQueryWrapper;
:eq(status=1) 动态条件;
:关键词 like title OR like skills;
:orderByDesc(createTime);
:selectPage 分页查库;
if (查询成功?) then (是)
  :fillCompanyName 补企业名;
  :组装 {records, total};
  :SET Redis 缓存 TTL 5分钟;
  :返回结果;
  stop
else (否)
  :异常处理;
  stop
endif
@enduml