@startuml 学生投递简历时序图
skinparam defaultFontName "Microsoft YaHei"
hide footbox
<style>
participant {
  FontColor white
  BorderColor white
  BackgroundColor white
}
sequenceDiagram {
  FontColor black
}
</style>
skinparam sequenceMessageAlign center
participant "学生" as stu
participant "岗位列表/详情页" as web
participant "StudentController" as ctl
participant "ApplyServiceImpl" as svc
stu -> web : 点击"立即投递"
web -> ctl : POST /api/student/applies {jobId:Long}
ctl -> svc : apply(studentId, jobId)
note over svc
  查岗位 job:Job
end note
alt 岗位不存在或不在招聘中(status≠1)
  svc --> ctl : 抛异常"该岗位不在招聘中"
  ctl --> web : Result(code≠0,msg)
else 岗位在招
  note over svc
    selectCount 查是否已投递
  end note
  alt 已投递过
    svc --> ctl : 抛异常"已投递过该岗位"
  else 未投递过
    note over svc
      组装 apply:Apply(studentId,jobId,"已投递")
    end note
    note over svc
      insert 落库
    end note
    svc --> ctl : void
    ctl --> web : Result("投递成功")
    web --> stu : 提示"投递成功"
  end
end

@enduml