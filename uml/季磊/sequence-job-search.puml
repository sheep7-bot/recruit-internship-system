@startuml 学生岗位搜索时序图
skinparam defaultFontName "Microsoft YaHei"
hide footbox
<style>
participant {
  FontColor white
  BorderColor white
  BackgroundColor white
}
sequenceDiagram {
  FontColor black
}
</style>
skinparam sequenceMessageAlign center
participant "学生" as stu
participant "岗位列表页" as web
participant "StudentController" as ctl
participant "JobServiceImpl" as svc
participant "Redis" as redis
stu -> web : 输入关键词/城市/类型并搜索
web -> ctl : GET /api/student/jobs?keyword&city&type&page&size
ctl -> svc : search(keyword, city, type, page, size)
note over svc
  分页参数兜底
end note
note over svc
  组装缓存key cache:jobs:{条件}|p{page}s{size}
end note
svc -> redis : GET cacheKey
alt 缓存命中
  redis --> svc : json:String(缓存结果)
  note over svc
    反序列化 → Map
  end note
  svc --> ctl : 直接返回 Map{records,total}
else 未命中
  note over svc
    组装 LambdaQueryWrapper(status=1)
  end note
  note over svc
    selectPage 分页查库
  end note
  note over svc
    fillCompanyName 补企业名
  end note
  svc -> redis : SET cacheKey json TTL 5分钟
  svc --> ctl : Map{records:List, total:Long}
end
ctl --> web : Result(data=Map)
web --> stu : 渲染岗位卡片+分页条

@enduml