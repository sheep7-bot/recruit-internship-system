@startuml 平台数据统计核心算法流程图
skinparam defaultFontName "Microsoft YaHei"
skinparam roundCorner 0

start
:开始;
:创建Map stats;
:selectCount(role=student)→studentCount;
:selectCount(t_company)→companyCount;
:selectCount(status=1)→jobCount;
:selectCount(t_apply)→applyCount;
:selectCount(t_resume)→resumeCount;
:selectCount(approved=0)→pendingCompanyCount;
:selectCount(status=0)→pendingJobCount;
if (任一统计失败?) then
  :全局异常处理器统一返回;
else
  :组装stats Map返回;
  :前端ECharts渲染;
endif
:结束;
stop
@enduml
