@startuml 数据统计时序图
skinparam defaultFontName "Microsoft YaHei"
hide footbox
<style>
participant {
  FontColor white
  BorderColor white
  BackgroundColor white
}
sequenceDiagram {
  FontColor black
}
</style>
skinparam sequenceMessageAlign center
participant "管理员" as admin
participant "管理端数据统计页" as web
participant "AdminController" as ctl
participant "AdminServiceImpl" as svc
admin -> web : 打开数据统计页
web -> ctl : GET /api/admin/stats
ctl -> svc : stats()
note over svc
  selectCount(role=student) 学生数
end note
note over svc
  selectCount(company) 企业数
end note
note over svc
  selectCount(status=1) 在招岗位数
end note
note over svc
  selectCount(apply) 投递总数
end note
note over svc
  selectCount(resume) 简历总数
end note
note over svc
  selectCount(approved=0) 待审核企业数
end note
note over svc
  selectCount(status=0) 待审核岗位数
end note
note over svc
  组装 stats:Map(studentCount/companyCount/jobCount/applyCount/resumeCount/pendingCompanyCount/pendingJobCount)
end note
svc --> ctl : Map
ctl --> web : Result(data=Map)
note over web
  ECharts 渲染仪表盘
end note
web --> admin : 展示平台数据总览

@enduml