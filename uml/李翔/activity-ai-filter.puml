@startuml AI双通道筛选活动图
skinparam defaultFontName "Microsoft YaHei"
skinparam activityDiamondFontSize 13
skinparam activityFontSize 13
skinparam defaultTextAlignment center

start
:HR 点击"AI 筛选候选人";
:POST /api/company/ai-filter/{jobId};
:校验岗位归属(防越权);
if (岗位属于当前企业?) then (否)
  :抛出异常"无权操作";
  stop
else (是)
endif
:查询该岗位全部投递记录;
while (还有候选人?) is (是)
  :查询候选人简历;
  if (简历存在?) then (否)
    :标记"未填写简历"，0分;
    :落库 t_ai_score;
  else (是)
    :规则通道 checkRule;
    if (学历命中 且 技能命中?) then (是)
      :组装评分提示词(岗位要求+简历摘要);
      :大模型调用评分;
      if (调用成功且JSON可解析?) then (是)
        :clamp 限制 0-100;
        :解析 score + reason;
      else (否)
        :降级中性分 50;
        :reason="AI评分暂不可用";
      endif
      :覆盖落库 t_ai_score(先删旧再插新);
    else (否)
      :标记"不符合规则"，0分+原因;
      :落库 t_ai_score;
    endif
  endif
endwhile (否)
:按评分从高到低排序;
:返回候选人评分列表;
:HR 查看结果并发起面试邀约;
stop
@enduml