@startuml 李翔-AI智能模块设计类图
skinparam defaultFontName "Microsoft YaHei"
skinparam classAttributeIconSize 0
skinparam defaultFontSize 12
skinparam defaultFontSize 12

package "Controller 控制层" {
  class AiController {
    -chatClient : ChatClient
    -aiResumeService : AiResumeService
    -aiMatchService : AiMatchService
    -redis : StringRedisTemplate
    +chat(question : String) : Result
    +chatStream(question : String) : Flux<String>
    +parseResume(resumeId : Long) : Result
    +recommend() : Result
    +applyAdvice(applyId : Long) : Result
    -overLimit(userId : Long) : boolean
  }
}

package "Service 业务层" {
  class AiResumeServiceImpl {
    -chatClient : ChatClient
    -resumeService : ResumeService
    -objectMapper : ObjectMapper
    +parse(resumeId : Long) : Resume
    -cleanJson(answer : String) : String
    -textOrKeep(node : JsonNode, fallback : String) : String
    -intOrKeep(node : JsonNode, fallback : Integer) : Integer
  }
  class AiMatchServiceImpl {
    -chatClient : ChatClient
    -jobMapper : JobMapper
    -applyMapper : ApplyMapper
    -resumeMapper : ResumeMapper
    -aiScoreMapper : AiScoreMapper
    -companyMapper : CompanyMapper
    -objectMapper : ObjectMapper
    +filter(companyUserId : Long, jobId : Long) : List
    +recommend(studentId : Long) : List
    +applyAdvice(studentId : Long, applyId : Long) : String
    -saveScore(applyId : Long, score : int, reason : String) : void
    -getResume(studentId : Long) : Resume
    -checkRule(job : Job, resume : Resume) : String
    -resumeBrief(resume : Resume) : String
    -safe(s : String) : String
    -clamp(score : int) : int
    -cleanJson(answer : String) : String
    -cleanJsonArray(answer : String) : String
  }
  class ResumeServiceImpl {
    -resumeMapper : ResumeMapper
    +getByUserId(userId : Long) : Resume
    +save(userId : Long, form : Resume) : void
    +getById(id : Long) : Resume
    +update(resume : Resume) : void
  }
}

package "Mapper 数据访问层" {
  class ResumeMapper
  class ApplyMapper
  class AiScoreMapper
  class JobMapper
  class CompanyMapper
}

package "entity 实体层" {
  class Resume {
    -id : Long
    -userId : Long
    -name : String
    -school : String
    -edu : String
    -age : Integer
    -skills : String
    -experience : String
    -content : String
    +getId() : Long
    +setId(id : Long) : void
    +getEdu() : String
    +setEdu(edu : String) : void
    +getSkills() : String
    +setSkills(skills : String) : void
    +getContent() : String
  }
  class Apply {
    -id : Long
    -studentId : Long
    -jobId : Long
    -status : String
    +getId() : Long
    +getStudentId() : Long
    +getJobId() : Long
    +getStatus() : String
  }
  class AiScore {
    -id : Long
    -applyId : Long
    -score : Integer
    -reason : String
    +setApplyId(applyId : Long) : void
    +setScore(score : Integer) : void
    +setReason(reason : String) : void
  }
  class Job {
    -id : Long
    -companyId : Long
    -title : String
    -skills : String
    -eduReq : String
    -description : String
    +getId() : Long
    +getTitle() : String
    +getSkills() : String
    +getEduReq() : String
    +getDescription() : String
  }
}

package "AI 服务" {
  class "ChatClient（Spring AI）" as ChatClient {
    +prompt(text) : Request
    +call() : Response
    +stream() : Flux
  }
  class "通义千问 API" as Qwen
}

class StringRedisTemplate {
  +increment(key : String) : Long
  +expire(key : String, timeout : Duration) : Boolean
}

AiController -- AiResumeServiceImpl
AiController -- AiMatchServiceImpl
AiController -- ChatClient
AiController -- StringRedisTemplate : AI限流

AiResumeServiceImpl -- ResumeServiceImpl
AiResumeServiceImpl -- ChatClient
AiMatchServiceImpl -- ResumeMapper
AiMatchServiceImpl -- ApplyMapper
AiMatchServiceImpl -- AiScoreMapper
AiMatchServiceImpl -- JobMapper
AiMatchServiceImpl -- CompanyMapper
AiMatchServiceImpl -- ChatClient

ResumeServiceImpl -- ResumeMapper
ChatClient -- Qwen
@enduml