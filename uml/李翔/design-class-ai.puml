@startuml 李翔-AI智能模块设计类图
skinparam defaultFontName "Microsoft YaHei"
skinparam classAttributeIconSize 0
skinparam defaultFontSize 14

package "Controller" {
  class AiController {
    +chat(question) : Result
    +chatStream(question) : Flux<String>
    +parseResume(resumeId) : Result
    +recommend() : Result
    +applyAdvice(applyId) : Result
  }
}

package "Service" {
  class AiResumeServiceImpl {
    +parse(resumeId) : Resume
    -cleanJson(answer) : String
    -textOrKeep(node, fallback) : String
  }
  class AiMatchServiceImpl {
    +filter(companyUserId, jobId) : List<Map>
    +recommend(studentId) : List<Map>
    +applyAdvice(studentId, applyId) : String
    -checkRule(job, resume) : String
    -saveScore(applyId, score, reason) : void
    -clamp(score) : int
  }
  class ResumeServiceImpl {
    +getById(id) : Resume
    +update(resume) : void
  }
}

package "Mapper 数据访问层" {
  class ResumeMapper
  class ApplyMapper
  class AiScoreMapper
  class JobMapper
  class CompanyMapper
}

package "entity 实体层" {
  class Resume {
    -id : Long
    -name : String
    -edu : String
    -skills : String
    -experience : String
    -content : String
  }
  class Apply {
    -id : Long
    -studentId : Long
    -jobId : Long
    -status : String
  }
  class AiScore {
    -id : Long
    -applyId : Long
    -score : Integer
    -reason : String
  }
  class Job {
    -id : Long
    -companyId : Long
    -title : String
    -skills : String
    -eduReq : String
  }
}

package "AI 服务" {
  class "ChatClient（Spring AI）" as ChatClient {
    +prompt(text) : Request
    +call() : Response
    +stream() : Flux
  }
  class "通义千问 API" as Qwen
}

class StringRedisTemplate

AiController --> AiResumeServiceImpl
AiController --> AiMatchServiceImpl
AiController --> ChatClient
AiController --> StringRedisTemplate : AI限流

AiResumeServiceImpl --> ResumeServiceImpl
AiResumeServiceImpl --> ChatClient
AiMatchServiceImpl --> ResumeMapper
AiMatchServiceImpl --> ApplyMapper
AiMatchServiceImpl --> AiScoreMapper
AiMatchServiceImpl --> JobMapper
AiMatchServiceImpl --> CompanyMapper
AiMatchServiceImpl --> ChatClient

ResumeServiceImpl --> ResumeMapper
ChatClient --> Qwen
@enduml