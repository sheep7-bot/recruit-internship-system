@startuml AI双通道筛选核心算法流程图
skinparam defaultFontName "Microsoft YaHei"
skinparam roundCorner 0

start
:开始;
:输入jobId、companyUserId;
:查岗位job并校验归属;
if (岗位存在且属于当前企业?) then
  :查全部投递applyList;
  :初始化result列表;
  :取出一个投递apply;
  while (还有未处理的投递?)
    :查候选人简历resume;
    if (简历为空?) then
      :aiScore=0，reason=未填写简历;
    else
      :规则通道checkRule;
      if (学历命中且技能命中?) then
        :组装评分提示词并调用大模型;
        if (调用成功且JSON可解析?) then
          :score=clamp(0-100)，reason=理由;
        else
          :score=50降级;
        endif
      else
        :aiScore=0，reason=未通过规则;
      endif
    endif
    :saveScore覆盖落库;
    :组装item加入result;
    :取出下一个投递;
  endwhile
  :result按aiScore降序排序;
  :返回result;
else
  :抛异常：无权操作;
endif
:结束;
stop
@enduml
