    if (解析成功?) then
      :逐字段textOrKeep/intOrKeep回填;
      if (字段为空或无效?) then
        :保留学生手填原值;
      else
      endif
      :update落库;
      :返回解析后的简历;
    else
      :抛异常：AI解析暂不可用;
    endif
  else
    :抛异常：AI解析暂不可用;
  endif
else
  :抛异常：简历内容为空;
endif
:结束;
stop
@enduml
