@startuml AI智能问答SSE流式时序图
skinparam defaultFontName "Microsoft YaHei"
hide footbox
<style>
participant {
  FontColor white
  BorderColor white
  BackgroundColor white
}
sequenceDiagram {
  FontColor black
}
</style>
skinparam sequenceMessageAlign center
participant "学生" as stu
participant "学生端页面(AiChat)" as web
participant "AiController" as ai
participant "ChatClient(Spring AI)" as llm
stu -> web : 输入求职问题 question:String
web -> ai : POST /api/ai/chat/stream {question}
note over ai
  Redis 限流(ratelimit:ai:{userId})
end note
alt 超过10次/分钟
  ai --> web : Flux.just("提问太频繁，请一分钟后再试")
else 未超限
  ai -> llm : prompt(question).stream()
  loop 逐段生成
    llm --> ai : chunk:String(增量文本块)
    ai --> web : SSE(text/event-stream)逐段推送
    web --> stu : 打字机效果逐字渲染
  end
  alt 流式中途出错
    ai --> web : Flux.just("【AI服务暂时不可用，请稍后再试】")
  end
end

@enduml